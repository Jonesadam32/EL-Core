{
    "name": "ELS Bookkeeping",
    "slug": "bookkeeping",
    "version": "1.0.0",
    "description": "Internal bookkeeping tool for expense categorization, income tracking, contractor management, receipt management, and Schedule C P&L reporting.",
    "author": "Expanded Learning Solutions",

    "requires": {
        "el_core": "1.3.0",
        "php": "8.0",
        "modules": []
    },

    "capabilities": [
        "manage_bookkeeping",
        "view_bookkeeping",
        "manage_bookkeeping_settings"
    ],

    "default_role_mapping": {
        "administrator": ["manage_bookkeeping", "view_bookkeeping", "manage_bookkeeping_settings"],
        "editor": ["view_bookkeeping", "manage_bookkeeping"]
    },

    "database": {
        "version": 14,
        "tables": {
            "el_bk_transactions": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "type": "varchar(20) NOT NULL DEFAULT 'expense'",
                "date": "date NOT NULL",
                "merchant": "varchar(500) NOT NULL DEFAULT ''",
                "amount": "decimal(10,2) NOT NULL DEFAULT 0.00",
                "category": "varchar(255) NOT NULL DEFAULT ''",
                "client_id": "bigint(20) NOT NULL DEFAULT 0",
                "bank_account": "varchar(255) NOT NULL DEFAULT ''",
                "business": "varchar(255) NOT NULL DEFAULT 'Expanded Learning Solutions'",
                "status": "varchar(20) NOT NULL DEFAULT 'unclassified'",
                "comments": "text NOT NULL DEFAULT ''",
                "source_file": "varchar(255) NOT NULL DEFAULT ''",
                "tax_year": "year NOT NULL",
                "travel_period_id": "bigint(20) NOT NULL DEFAULT 0",
                "receipt_id": "bigint(20) NOT NULL DEFAULT 0",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "updated_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "KEY idx_type_year": "(type, tax_year)",
                "KEY idx_status": "(status)",
                "KEY idx_category": "(category)",
                "KEY idx_date": "(date)",
                "KEY idx_client_id": "(client_id)",
                "invoice_id": "bigint(20) NOT NULL DEFAULT 0",
                "KEY idx_invoice_id": "(invoice_id)",
                "parent_id": "bigint(20) NOT NULL DEFAULT 0",
                "KEY idx_parent_id": "(parent_id)",
                "contractor_id": "bigint(20) NOT NULL DEFAULT 0",
                "KEY idx_contractor_id": "(contractor_id)"
            },
            "el_bk_rules": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "keyword": "varchar(255) NOT NULL",
                "match_type": "varchar(10) NOT NULL DEFAULT 'contains'",
                "category": "varchar(255) NOT NULL",
                "priority": "int(11) NOT NULL DEFAULT 0",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "KEY idx_priority": "(priority)"
            },
            "el_bk_travel_periods": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "label": "varchar(255) NOT NULL DEFAULT ''",
                "start_date": "date NOT NULL",
                "end_date": "date NOT NULL",
                "purpose": "varchar(500) NOT NULL DEFAULT ''",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "KEY idx_dates": "(start_date, end_date)"
            },
            "el_bk_receipts": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "transaction_id": "bigint(20) NOT NULL DEFAULT 0",
                "file_path": "varchar(500) NOT NULL DEFAULT ''",
                "file_url": "varchar(500) NOT NULL DEFAULT ''",
                "file_type": "varchar(20) NOT NULL DEFAULT ''",
                "ai_extracted_merchant": "varchar(255) NOT NULL DEFAULT ''",
                "ai_extracted_date": "date DEFAULT NULL",
                "ai_extracted_amount": "decimal(10,2) DEFAULT NULL",
                "ai_extracted_category": "varchar(255) NOT NULL DEFAULT ''",
                "location": "varchar(255) NOT NULL DEFAULT ''",
                "notes": "text NOT NULL DEFAULT ''",
                "match_source": "varchar(20) NOT NULL DEFAULT ''",
                "ai_raw_response": "text NOT NULL DEFAULT ''",
                "status": "varchar(20) NOT NULL DEFAULT 'unmatched'",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "KEY idx_transaction": "(transaction_id)",
                "KEY idx_status": "(status)"
            },
            "el_bk_contractors": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "name": "varchar(255) NOT NULL",
                "email": "varchar(255) NOT NULL DEFAULT ''",
                "address": "text NOT NULL DEFAULT ''",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)"
            },
            "el_bk_contractor_assignments": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "transaction_id": "bigint(20) NOT NULL",
                "contractor_id": "bigint(20) NOT NULL",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "KEY idx_transaction": "(transaction_id)",
                "KEY idx_contractor": "(contractor_id)"
            },
            "el_bk_clients": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "client_name": "varchar(255) NOT NULL",
                "short_name": "varchar(100) NOT NULL DEFAULT ''",
                "ein": "varchar(20) NOT NULL DEFAULT ''",
                "contact_name": "varchar(255) NOT NULL DEFAULT ''",
                "contact_email": "varchar(255) NOT NULL DEFAULT ''",
                "contact_phone": "varchar(50) NOT NULL DEFAULT ''",
                "address": "text NOT NULL DEFAULT ''",
                "contract_type": "varchar(100) NOT NULL DEFAULT ''",
                "status": "enum('active','inactive','completed') NOT NULL DEFAULT 'active'",
                "bank_patterns": "text NOT NULL DEFAULT ''",
                "notes": "text NOT NULL DEFAULT ''",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "updated_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "KEY idx_status": "(status)",
                "KEY idx_short_name": "(short_name)"
            },
            "el_bk_1099_nec": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "client_id": "bigint(20) NOT NULL DEFAULT 0",
                "tax_year": "year NOT NULL",
                "box1_amount": "decimal(12,2) NOT NULL DEFAULT 0.00",
                "date_received": "date DEFAULT NULL",
                "document_status": "enum('received','missing','substitute') NOT NULL DEFAULT 'received'",
                "document_attachment_id": "bigint(20) NOT NULL DEFAULT 0",
                "form_4852_attachment_id": "bigint(20) NOT NULL DEFAULT 0",
                "supporting_doc_attachment_id": "bigint(20) NOT NULL DEFAULT 0",
                "supporting_doc_title": "varchar(255) NOT NULL DEFAULT ''",
                "substitute_docs": "text NOT NULL DEFAULT ''",
                "reconciliation_status": "enum('pending','reconciled','discrepancy') NOT NULL DEFAULT 'pending'",
                "verified_at": "datetime DEFAULT NULL",
                "notes": "text NOT NULL DEFAULT ''",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "updated_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "UNIQUE KEY unique_client_year": "(client_id, tax_year)",
                "KEY idx_tax_year": "(tax_year)",
                "KEY idx_reconciliation": "(reconciliation_status)"
            },
            "el_bk_gmail_accounts": {
                "id":            "bigint(20) NOT NULL AUTO_INCREMENT",
                "label":         "varchar(100) NOT NULL DEFAULT ''",
                "email":         "varchar(200) NOT NULL DEFAULT ''",
                "access_token":  "text NOT NULL DEFAULT ''",
                "refresh_token": "text NOT NULL DEFAULT ''",
                "token_expires": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "status":        "enum('active','expired','error') NOT NULL DEFAULT 'active'",
                "created_at":    "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "updated_at":    "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
                "PRIMARY KEY":   "(id)",
                "KEY idx_email":  "(email)",
                "KEY idx_status": "(status)"
            },
            "el_bk_gmail_scan_log": {
                "id":                 "bigint(20) NOT NULL AUTO_INCREMENT",
                "account_id":         "bigint(20) NOT NULL DEFAULT 0",
                "scan_month":         "varchar(7) NOT NULL DEFAULT ''",
                "scanned_at":         "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "emails_found":       "int(11) NOT NULL DEFAULT 0",
                "receipts_extracted": "int(11) NOT NULL DEFAULT 0",
                "PRIMARY KEY":              "(id)",
                "KEY idx_account_month":    "(account_id, scan_month)"
            },
            "el_bk_invoices": {
                "id": "bigint(20) NOT NULL AUTO_INCREMENT",
                "client_id": "bigint(20) NOT NULL DEFAULT 0",
                "invoice_number": "varchar(50) NOT NULL DEFAULT ''",
                "invoice_date": "date NOT NULL",
                "amount": "decimal(12,2) NOT NULL DEFAULT 0.00",
                "description": "text NOT NULL DEFAULT ''",
                "status": "enum('unpaid','paid','partial','void') NOT NULL DEFAULT 'unpaid'",
                "document_attachment_id": "bigint(20) NOT NULL DEFAULT 0",
                "transaction_id": "bigint(20) NOT NULL DEFAULT 0",
                "withholding_amount": "decimal(10,2) NOT NULL DEFAULT 0.00",
                "withholding_type": "varchar(50) NOT NULL DEFAULT ''",
                "ai_extracted_data": "text NOT NULL DEFAULT ''",
                "notes": "text NOT NULL DEFAULT ''",
                "created_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP",
                "updated_at": "datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
                "PRIMARY KEY": "(id)",
                "UNIQUE KEY unique_invoice_number": "(invoice_number)",
                "KEY idx_client": "(client_id)",
                "KEY idx_status": "(status)",
                "KEY idx_transaction": "(transaction_id)",
                "KEY idx_date": "(invoice_date)"
            }
        },
        "migrations": {
            "2": "ALTER TABLE el_bk_receipts ADD COLUMN location varchar(255) NOT NULL DEFAULT ''",
            "3": "ALTER TABLE el_bk_receipts ADD COLUMN notes text NOT NULL DEFAULT ''",
            "4": "ALTER TABLE el_bk_receipts ADD COLUMN match_source varchar(20) NOT NULL DEFAULT ''",
            "5": "ALTER TABLE el_bk_transactions ADD COLUMN IF NOT EXISTS receipt_id bigint(20) NOT NULL DEFAULT 0",
            "6": "ALTER TABLE el_bk_transactions ADD COLUMN IF NOT EXISTS client_id bigint(20) NOT NULL DEFAULT 0",
            "7": "ALTER TABLE el_bk_1099_nec ADD COLUMN IF NOT EXISTS form_4852_attachment_id bigint(20) NOT NULL DEFAULT 0",
            "8": "ALTER TABLE el_bk_1099_nec ADD COLUMN IF NOT EXISTS supporting_doc_attachment_id bigint(20) NOT NULL DEFAULT 0, ADD COLUMN IF NOT EXISTS supporting_doc_title varchar(255) NOT NULL DEFAULT ''",
            "9": "CREATE TABLE IF NOT EXISTS {prefix}el_bk_invoices ( id bigint(20) NOT NULL AUTO_INCREMENT, client_id bigint(20) NOT NULL DEFAULT 0, invoice_number varchar(50) NOT NULL DEFAULT '', invoice_date date NOT NULL, amount decimal(12,2) NOT NULL DEFAULT 0.00, description text NOT NULL DEFAULT '', status enum('unpaid','paid','partial','void') NOT NULL DEFAULT 'unpaid', document_attachment_id bigint(20) NOT NULL DEFAULT 0, transaction_id bigint(20) NOT NULL DEFAULT 0, withholding_amount decimal(10,2) NOT NULL DEFAULT 0.00, withholding_type varchar(50) NOT NULL DEFAULT '', ai_extracted_data text NOT NULL DEFAULT '', notes text NOT NULL DEFAULT '', created_at datetime NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, PRIMARY KEY (id), UNIQUE KEY unique_invoice_number (invoice_number), KEY idx_client (client_id), KEY idx_status (status), KEY idx_transaction (transaction_id), KEY idx_date (invoice_date) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
            "10": "ALTER TABLE {prefix}el_bk_transactions ADD COLUMN IF NOT EXISTS invoice_id bigint(20) NOT NULL DEFAULT 0",
            "11": "ALTER TABLE {prefix}el_bk_transactions ADD COLUMN IF NOT EXISTS parent_id bigint(20) NOT NULL DEFAULT 0",
            "12": "ALTER TABLE el_bk_transactions ADD COLUMN IF NOT EXISTS contractor_id bigint(20) NOT NULL DEFAULT 0",
            "13": "CREATE TABLE IF NOT EXISTS el_bk_gmail_accounts ( id bigint(20) NOT NULL AUTO_INCREMENT, label varchar(100) NOT NULL DEFAULT '', email varchar(200) NOT NULL DEFAULT '', access_token text NOT NULL DEFAULT '', refresh_token text NOT NULL DEFAULT '', token_expires datetime NOT NULL DEFAULT CURRENT_TIMESTAMP, status enum('active','expired','error') NOT NULL DEFAULT 'active', created_at datetime NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, PRIMARY KEY (id), KEY idx_email (email), KEY idx_status (status) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
            "14": "CREATE TABLE IF NOT EXISTS el_bk_gmail_scan_log ( id bigint(20) NOT NULL AUTO_INCREMENT, account_id bigint(20) NOT NULL DEFAULT 0, scan_month varchar(7) NOT NULL DEFAULT '', scanned_at datetime NOT NULL DEFAULT CURRENT_TIMESTAMP, emails_found int(11) NOT NULL DEFAULT 0, receipts_extracted int(11) NOT NULL DEFAULT 0, PRIMARY KEY (id), KEY idx_account_month (account_id, scan_month) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
        }
    },

    "shortcodes": [],

    "settings": [
        { "key": "business_name",             "label": "Business Name",              "type": "string",  "default": "Expanded Learning Solutions LLC" },
        { "key": "owner_legal_name",          "label": "Owner Legal Name",           "type": "string",  "default": "" },
        { "key": "ein",                       "label": "EIN",                        "type": "string",  "default": "" },
        { "key": "business_address",          "label": "Business Address",           "type": "string",  "default": "" },
        { "key": "business_type",             "label": "Business Type",              "type": "string",  "default": "sole_proprietor" },
        { "key": "business_start_date",       "label": "Business Start Date",        "type": "string",  "default": "" },
        { "key": "accounting_method",         "label": "Accounting Method",          "type": "string",  "default": "cash" },
        { "key": "naics_code",                "label": "Principal Business Code",    "type": "string",  "default": "" },
        { "key": "tax_year",                  "label": "Default Tax Year",           "type": "number",  "default": 2025 },

        { "key": "home_office_enabled",       "label": "Claim Home Office",          "type": "boolean", "default": false },
        { "key": "home_office_method",        "label": "Home Office Method",         "type": "string",  "default": "simplified" },
        { "key": "home_office_sqft",          "label": "Office Square Footage",      "type": "number",  "default": 0 },
        { "key": "home_total_sqft",           "label": "Total Home Square Footage",  "type": "number",  "default": 0 },
        { "key": "home_office_pct",           "label": "Home Office % (Indirect)",   "type": "number",  "default": 0 },
        { "key": "home_mortgage_rent",        "label": "Mortgage/Rent",              "type": "number",  "default": 0 },
        { "key": "home_real_estate_taxes",    "label": "Real Estate Taxes",          "type": "number",  "default": 0 },
        { "key": "home_utilities",            "label": "Utilities",                  "type": "number",  "default": 0 },
        { "key": "home_insurance",            "label": "Homeowners Insurance",       "type": "number",  "default": 0 },
        { "key": "home_repairs",              "label": "Repairs & Maintenance",      "type": "number",  "default": 0 },
        { "key": "home_depreciation",         "label": "Depreciation",               "type": "number",  "default": 0 },

        { "key": "vehicle_enabled",           "label": "Claim Vehicle Deduction",    "type": "boolean", "default": false },
        { "key": "vehicle_description",       "label": "Vehicle Description",        "type": "string",  "default": "" },
        { "key": "vehicle_service_date",      "label": "Date Placed in Service",     "type": "string",  "default": "" },
        { "key": "vehicle_method",            "label": "Vehicle Method",             "type": "string",  "default": "standard" },
        { "key": "vehicle_total_miles",       "label": "Total Miles Driven",         "type": "number",  "default": 0 },
        { "key": "vehicle_business_miles",    "label": "Business Miles Driven",      "type": "number",  "default": 0 },
        { "key": "vehicle_mileage_rate",      "label": "Mileage Rate",               "type": "number",  "default": 0.70 },
        { "key": "vehicle_gas",               "label": "Gas & Oil",                  "type": "number",  "default": 0 },
        { "key": "vehicle_insurance",         "label": "Auto Insurance",             "type": "number",  "default": 0 },
        { "key": "vehicle_repairs",           "label": "Repairs & Maintenance",      "type": "number",  "default": 0 },
        { "key": "vehicle_registration",      "label": "Registration & Licenses",    "type": "number",  "default": 0 },
        { "key": "vehicle_lease",             "label": "Lease Payments",             "type": "number",  "default": 0 },
        { "key": "vehicle_depreciation",      "label": "Depreciation",               "type": "number",  "default": 0 },

        { "key": "health_insurance_premium",  "label": "Health Insurance Premium",   "type": "number",  "default": 0 },
        { "key": "retirement_sep_ira",        "label": "SEP-IRA Contributions",      "type": "number",  "default": 0 },
        { "key": "retirement_solo_401k",      "label": "Solo 401(k) Contributions",  "type": "number",  "default": 0 },
        { "key": "retirement_simple_ira",     "label": "SIMPLE IRA Contributions",   "type": "number",  "default": 0 },
        { "key": "professional_licenses",     "label": "Professional Licenses",      "type": "number",  "default": 0 },
        { "key": "professional_memberships",  "label": "Professional Memberships",   "type": "number",  "default": 0 },
        { "key": "continuing_education",      "label": "Continuing Education",       "type": "number",  "default": 0 },
        { "key": "business_insurance",        "label": "Business Insurance",         "type": "number",  "default": 0 },
        { "key": "bank_merchant_fees",        "label": "Bank/Merchant Fees",         "type": "number",  "default": 0 },
        { "key": "software_subscriptions",    "label": "Software Subscriptions",     "type": "number",  "default": 0 }
    ]
}
